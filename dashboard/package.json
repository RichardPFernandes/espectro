{
  "name": "graph-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Dashboard local de observabilidade do watcher (scripts/readmine-watcher.js) com canal humano→agente",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "tsc -b --pretty false",
    "check:js": "tsc -p tsconfig.checkjs.json --pretty false --noEmit",
    "test": "node ../harness/run-tests.js dashboard"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.16.0",
    "chokidar": "^3.5.3"
  }
}
