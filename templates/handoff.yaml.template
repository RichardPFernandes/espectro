# Maestri — Agent Handoff Contract v1.2. Regras: docs/handoff-contract.md
# Opcional pelo Acordo v2: só quando o coordenador Maestri pedir. Fatias novas não exigem handoff; a evidência vai no PR.
# Validar antes de entregar: node scripts/validate-handoff.js <arquivo>
# status: COMPLETED | BLOCKED | NEEDS_HUMAN | FAILED | PARTIAL
# result de validation.executed só é PASSED com execução comprovada em evidence.
handoff_version: "1.2"

# Nível de processo (AGENTS.md, «Níveis de processo»): leve | medio | alto.
# Na dúvida, o maior. Mudou de nível? Preencha o inicial e o motivo; descer só com o Richard.
nivel_processo: ""
nivel_processo_inicial: null
nivel_processo_motivo: null

task:
  id: "PRI-XXX"
  objective: ""
  specification_ref: ""
  acceptance_criteria: []

routing:
  from: ""
  to: ""
  runtime: ""            # claude | codex | human | other
  fallback_reason: null

risk:
  level: ""              # LOW | MEDIUM | HIGH | MAX
  signals: []            # obrigatório em HIGH/MAX; 1º item = "G<n>: <sinal>" (perfil G0–G3)
  classified_by: ""

execution:
  agent: ""
  status: ""
  summary: ""
  branch: ""
  commit: null

artifacts: []
  # - path: ""
  #   action: "CREATED | MODIFIED | DELETED"
  #   description: ""

decisions:
  approved: []
  proposed: []

validation:
  executed: []
    # - command: ""
    #   result: "PASSED | FAILED"
    #   expected: "PASSED"     # FAILED só em teste de injeção de falha
    #   evidence: ""
  not_executed: []

open_issues: []

next:
  recommended_agent: ""
  action: ""
  prerequisites: []

context_refs: []

facts: []
assumptions: []

usage:                   # só valores observados; senão UNKNOWN
  duration: "UNKNOWN"
  retries: 0
  tokens: "UNKNOWN"

# closure é lido só por --pre-done. Sem esse bloco, a aceitação do handoff segue igual.
