# Exemplo neutro para configuração no CONSUMIDOR. Não cria .env da plataforma.
# Não transportar secrets ou dados do projeto; preencher apenas no ambiente admitido.
# O gate de integração/cutover não é satisfeito por preencher este arquivo.

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
BITBUCKET_ACCOUNT_ID=

# Secret opcional do adapter correspondente; obter com seu owner e manter só no consumidor; nunca versionar/imprimir valor.
BITBUCKET_API_TOKEN=

# Referência obrigatória na configuração do adapter Redmine/Bitbucket existente; preencher no consumidor conforme seu owner.
BITBUCKET_EMAIL=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
BITBUCKET_PR_REPOS=

# Referência obrigatória na configuração do adapter Redmine/Bitbucket existente; preencher no consumidor conforme seu owner.
BITBUCKET_REPO_SLUG=

# Referência obrigatória na configuração do adapter Redmine/Bitbucket existente; preencher no consumidor conforme seu owner.
BITBUCKET_WORKSPACE=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
CHURN_THRESHOLD=

# JSON do consumidor [label,regexSource,flags], ordem preservada; sem arquivo = nenhuma taxonomia inferida.
CONSOLIDATOR_MODULE_KEYWORDS_FILE=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
DISABLE_AUTO_CLEANUP=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
GRACEFUL_TIMEOUT_MS=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
HUMAN_INPUT_INTERPRETER_MODEL=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
HUMAN_INPUT_INTERPRETER_TIMEOUT_MS=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
HUMAN_INPUT_MIN_CONFIDENCE=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
MAX_ATTACHMENT_SIZE_MB=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
MS_ROUTER=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
NODE_TIMEOUT_MS=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
NOTIFY_WEBHOOK_URL=

# JSON do consumidor method→HTTP status para helper específico; não assumir ResponseFactory de outro projeto.
OPENAPI_RESPONSE_FACTORY_FILE=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
PLAN_SCORE_THRESHOLD=

# Ativa só adapter existente com valor maven-quarkus-grunt; sem valor preview não habilitado.
PREVIEW_ADAPTER=

# Path explícito para lib do adapter Maven; absoluto ou relativo ao consumidor.
PREVIEW_APP_CORE_REPO=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
PREVIEW_BACK_PORT=

# Profiles/rótulos explícitos do consumidor; não default de banco/cliente de app-back.
PREVIEW_DB_OPTIONS=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
PREVIEW_FRONT_DIR=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
PREVIEW_FRONT_PORT=

# Path explícito para frontend do adapter Grunt; absoluto ou relativo ao consumidor.
PREVIEW_FRONT_REPO=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
PREVIEW_GRUNT_FORCE=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
PREVIEW_GRUNT_WATCH=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
PREVIEW_JAVA_HOME=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
PREVIEW_LIBS_FROM_BRANCH=

# Refs explícitas de libs do consumidor, sem assumir master/development.
PREVIEW_LIB_REFS=

# Path explícito para lib do adapter Maven; absoluto ou relativo ao consumidor.
PREVIEW_MO_ENTITY_REPO=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
PREVIEW_MVN_OFFLINE=

# Profile explicitamente autorizado pelo consumidor.
PREVIEW_PROFILE=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
PRE_BUILD_AI_FIX_TIMEOUT_MS=

# Comando explícito da toolchain do consumidor; ausente impede build, não assume Maven.
PRE_BUILD_COMMAND=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
PRE_BUILD_JAVA_HOME=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
PRE_BUILD_TIMEOUT_MS=

# Raiz absoluta da versão candidata fixada da plataforma (código/assets; não estado).
PRISMA_ROOT=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
PR_STATUS_POLL_INTERVAL_MS=

# Secret opcional do adapter correspondente; obter com seu owner e manter só no consumidor; nunca versionar/imprimir valor.
REDMINE_API_KEY=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
REDMINE_STATUS_EM_DESENVOLVIMENTO_ID=

# Referência obrigatória na configuração do adapter Redmine/Bitbucket existente; preencher no consumidor conforme seu owner.
REDMINE_URL=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
REDMINE_USER_ID=

# Obrigatória para operação: checkout principal absoluto do consumidor; nunca pasta Prisma por default.
REPO_PATH=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
SKIP_PRE_BUILD_VALIDATION=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
SPEC_APPROVAL_KEYWORD=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
SPEC_APPROVAL_REMINDER_HOURS=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
SPEC_AUTO_REPAIR=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
SPEC_CATEGORY_SERVICE_MAP=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
SPEC_DRAFT_AUTOGEN=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
SPEC_DRAFT_LINK_BASE=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
SPEC_REJECTION_KEYWORD=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
SPEC_REPAIR_CLAUDE_BIN=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
SPEC_REPAIR_MODEL=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
SPEC_REPAIR_TIMEOUT_MS=

# Prefixo Java explícito do consumidor usado pela heurística de regras; ausente não infere pacote de app-back.
SPEC_RULE_PACKAGE_PREFIX=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
SPEC_TEMPLATE_URL=

# Comando explícito da suíte do consumidor, com flags que habilitam seus testes.
TEST_COMMAND=

# Comando configurado para serviços; placeholder {services}. Sem configuração não escolher stack.
TEST_SCOPED_COMMAND=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
TRANSCRIPTS_DISABLED=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
TRANSCRIPTS_RETENTION_DAYS=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
TRANSCRIPT_GZIP_THRESHOLD_BYTES=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
USD_BRL=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
WATCHER_JAVA_HOME=

# Nome explícito do repo principal para preservar as keys históricas do consumidor.
WATCHER_MAIN_REPO_NAME=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
WATCHER_RECUSA_QA_NOVO_CICLO=

# Lista de slugs de repos relacionados separada por vírgula; vazia = nenhum.
WATCHER_SIBLING_REPOS=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
WATCHER_TICK_INTERVAL_MS=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
WORKTREE_CLEANUP_ON_PR_OPEN=

# Intervalo do adapter REST, default500ms; não regula MCP.
REDMINE_MIN_INTERVAL_MS=

# Backoff REST, default1000ms; sem ampliar retry de efeitos incertos.
REDMINE_RETRY_BASE_DELAY_MS=

# Tentativas REST, default3; inclui primeira.
REDMINE_RETRY_MAX_ATTEMPTS=

# Retenção de escalated/state_corrupted, default90dias; proteção de runs ativos preservada.
RUNS_ERROR_RETENTION_DAYS=

# Rotação de terminais, default30dias; nunca mover estado ativo por esta referência.
RUNS_RETENTION_DAYS=

# Retenção de screenshots terminais, default14dias; exclusão só pela operação admitida.
SCREENSHOTS_RETENTION_DAYS=

# Referência opcional da conta Claude selecionada pelo consumidor; sem copiar credenciais.
WATCHER_CLAUDE_CONFIG_DIR=
