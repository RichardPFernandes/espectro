# Exemplo neutro para configuração no CONSUMIDOR. Não cria .env da plataforma.
# Não transportar secrets ou dados do projeto; preencher apenas no ambiente admitido.
# O gate de integração/cutover não é satisfeito por preencher este arquivo.

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
BITBUCKET_ACCOUNT_ID=

# Secret opcional do adapter correspondente; obter com seu owner e manter só no consumidor; nunca versionar/imprimir valor.
BITBUCKET_API_TOKEN=

# Referência obrigatória na configuração do adapter Redmine/Bitbucket existente; preencher no consumidor conforme seu owner.
# Leitura fora do scanner: só consta na lista de repasse de scripts/lib/node-dispatcher.js e é conferida em .claude/commands/commit.md; scripts/bitbucket-open-pr.sh não a usa.
BITBUCKET_EMAIL=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
BITBUCKET_PR_REPOS=

# Referência obrigatória na configuração do adapter Redmine/Bitbucket existente; preencher no consumidor conforme seu owner.
BITBUCKET_REPO_SLUG=

# Referência obrigatória na configuração do adapter Redmine/Bitbucket existente; preencher no consumidor conforme seu owner.
BITBUCKET_WORKSPACE=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
CHURN_THRESHOLD=

# JSON do consumidor [label,regexSource,flags], ordem preservada; sem arquivo = nenhuma taxonomia inferida.
CONSOLIDATOR_MODULE_KEYWORDS_FILE=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
DISABLE_AUTO_CLEANUP=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
GRACEFUL_TIMEOUT_MS=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
HUMAN_INPUT_INTERPRETER_MODEL=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
HUMAN_INPUT_INTERPRETER_TIMEOUT_MS=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
HUMAN_INPUT_MIN_CONFIDENCE=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
MAX_ATTACHMENT_SIZE_MB=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
MS_ROUTER=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
NODE_TIMEOUT_MS=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
NOTIFY_WEBHOOK_URL=

# JSON do consumidor method→HTTP status para helper específico; não assumir ResponseFactory de outro projeto.
OPENAPI_RESPONSE_FACTORY_FILE=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
PLAN_SCORE_THRESHOLD=

# Ativa só adapter existente com valor maven-quarkus-grunt; sem valor preview não habilitado.
PREVIEW_ADAPTER=

# Path explícito para lib do adapter Maven; absoluto ou relativo ao consumidor.
# Leitura fora do scanner: scripts/preview-manager.js, configuredRepo('PREVIEW_APP_CORE_REPO').
PREVIEW_APP_CORE_REPO=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
PREVIEW_BACK_PORT=

# Profiles/rótulos explícitos do consumidor; não default de banco/cliente de app-back.
PREVIEW_DB_OPTIONS=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
PREVIEW_FRONT_DIR=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
PREVIEW_FRONT_PORT=

# Path explícito para frontend do adapter Grunt; absoluto ou relativo ao consumidor.
# Leitura fora do scanner: scripts/preview-manager.js, configuredRepo('PREVIEW_FRONT_REPO').
PREVIEW_FRONT_REPO=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
PREVIEW_GRUNT_FORCE=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
PREVIEW_GRUNT_WATCH=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
PREVIEW_JAVA_HOME=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
PREVIEW_LIBS_FROM_BRANCH=

# Refs explícitas de libs do consumidor, sem assumir master/development.
PREVIEW_LIB_REFS=

# Repositório Maven só do preview (install/download do mvn dele); o ~/.m2 fica só para leitura. Padrão ~/.cache/prisma-preview/m2; aceita ~/.
PREVIEW_M2_REPO=

# Path explícito para lib do adapter Maven; absoluto ou relativo ao consumidor.
# Leitura fora do scanner: scripts/preview-manager.js, configuredRepo('PREVIEW_MO_ENTITY_REPO').
PREVIEW_MO_ENTITY_REPO=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
PREVIEW_MVN_OFFLINE=

# Profile explicitamente autorizado pelo consumidor.
PREVIEW_PROFILE=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
PRE_BUILD_AI_FIX_TIMEOUT_MS=

# Comando explícito da toolchain do consumidor; ausente impede build, não assume Maven.
PRE_BUILD_COMMAND=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
PRE_BUILD_JAVA_HOME=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
PRE_BUILD_TIMEOUT_MS=

# Painel Versão do dashboard: linha de shell que recebe o SHA alvo e move o pin do consumidor; vazia = somente leitura.
PRISMA_BUMP_COMMAND=

# Painel Versão: linha de shell que sobe o dashboard de novo depois do bump; vazia = reinício manual.
PRISMA_RESTART_COMMAND=

# Raiz absoluta da versão candidata fixada da plataforma (código/assets; não estado).
PRISMA_ROOT=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
PR_STATUS_POLL_INTERVAL_MS=

# Secret opcional do adapter correspondente; obter com seu owner e manter só no consumidor; nunca versionar/imprimir valor.
REDMINE_API_KEY=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
REDMINE_STATUS_EM_DESENVOLVIMENTO_ID=

# Referência obrigatória na configuração do adapter Redmine/Bitbucket existente; preencher no consumidor conforme seu owner.
REDMINE_URL=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
REDMINE_USER_ID=

# Obrigatória para operação: checkout principal absoluto do consumidor; nunca pasta Prisma por default.
REPO_PATH=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
SKIP_PRE_BUILD_VALIDATION=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
SPEC_APPROVAL_KEYWORD=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
SPEC_APPROVAL_REMINDER_HOURS=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
SPEC_AUTO_REPAIR=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
SPEC_CATEGORY_SERVICE_MAP=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
SPEC_DRAFT_AUTOGEN=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
SPEC_DRAFT_LINK_BASE=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
SPEC_REJECTION_KEYWORD=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
SPEC_REPAIR_CLAUDE_BIN=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
SPEC_REPAIR_MODEL=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
SPEC_REPAIR_TIMEOUT_MS=

# Prefixo Java explícito do consumidor usado pela heurística de regras; ausente não infere pacote de app-back.
SPEC_RULE_PACKAGE_PREFIX=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
SPEC_TEMPLATE_URL=

# Comando explícito da suíte do consumidor, com flags que habilitam seus testes.
TEST_COMMAND=

# Comando configurado para serviços; placeholder {services}. Sem configuração não escolher stack.
TEST_SCOPED_COMMAND=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
TRANSCRIPTS_DISABLED=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
TRANSCRIPTS_RETENTION_DAYS=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
TRANSCRIPT_GZIP_THRESHOLD_BYTES=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
USD_BRL=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
WATCHER_JAVA_HOME=

# Nome explícito do repo principal para preservar as keys históricas do consumidor.
WATCHER_MAIN_REPO_NAME=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
WATCHER_RECUSA_QA_NOVO_CICLO=

# Lista de slugs de repos relacionados separada por vírgula; vazia = nenhum.
WATCHER_SIBLING_REPOS=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
WATCHER_TICK_INTERVAL_MS=

# Opcional; só configurar quando usar o mecanismo/adapter correspondente; sem valor preserva o default documentado no código selecionado.
WORKTREE_CLEANUP_ON_PR_OPEN=

# Intervalo do adapter REST, default500ms; não regula MCP.
REDMINE_MIN_INTERVAL_MS=

# Backoff REST, default1000ms; sem ampliar retry de efeitos incertos.
REDMINE_RETRY_BASE_DELAY_MS=

# Tentativas REST, default3; inclui primeira.
REDMINE_RETRY_MAX_ATTEMPTS=

# Retenção de escalated/state_corrupted, default90dias; proteção de runs ativos preservada.
RUNS_ERROR_RETENTION_DAYS=

# Rotação de terminais, default30dias; nunca mover estado ativo por esta referência.
RUNS_RETENTION_DAYS=

# Retenção de screenshots terminais, default14dias; exclusão só pela operação admitida.
SCREENSHOTS_RETENTION_DAYS=

# Referência opcional da conta Claude selecionada pelo consumidor; sem copiar credenciais.
WATCHER_CLAUDE_CONFIG_DIR=

# ── Autorização humana / SQL governado / devolução ao QA (PRI-180) ──────────────────
# Allowlist de bancos, aprovadores e senhas NÃO ficam neste arquivo nem em variável de
# ambiente (um agente escreve no .env do consumidor). Ficam só em ~/.config/prisma/
# (dono = você, modo 600) e no Keychain do macOS. Cadastre com:
#   node "$PRISMA_ROOT/scripts/lib/approvers.js" add <nome>
#   node "$PRISMA_ROOT/scripts/lib/db-targets.js" add qa-app \
#        --from-properties=src/main/resources/application.properties --env=qa --label="QA – embarc_db_stage"
# Ver docs/runbook.md, "Autorização humana".

# Id do status "Ag Teste" no Redmine para a devolução ao QA; default 8.
REDMINE_STATUS_AG_TESTE=

# Id do campo custom "Apontamentos Desenvolvedor" preenchido na devolução ao QA; default 2.
REDMINE_CF_APONTAMENTOS_ID=

# ── Modo simulado (DRY_RUN) ─────────────────────────────────────────────────────────
# Ciclo inteiro com ticket sintético, agente simulado e nenhuma chamada externa
# (scripts/lib/dry-run.js). Desligado por padrão. Na raiz da plataforma, `npm run demo`
# já define tudo isto num consumidor temporário; ver README, "Veja funcionando".
# DRY_RUN só liga pelo ambiente do processo, com o valor exato `true`: uma linha no .env
# do consumidor é ignorada de propósito. Por isso as linhas ficam comentadas, como
# referência. Nunca exportar num início vivo (docs/consumer-operations.md).
# DRY_RUN=true

# Fixture do ticket: caminho absoluto, ou relativo ao cwd e depois a REPO_PATH.
# Sem valor, usa REPO_PATH/scripts/fixtures/ticket-example.json, que precisa existir.
# DRY_RUN_FIXTURE=

# Multiplicador das esperas por nó; default 1 (cerca de 13 s por ciclo); 0 = sem espera.
# DRY_RUN_DELAY_FACTOR=

# `high` simula risco alto no verify (PR com [HIGH-RISK]); sem valor = low.
# DRY_RUN_RISK_LEVEL=

# ── Flags e ajustes que o código lia sem constar aqui (PRI-377, F1.1) ────────────────
# Cada flag tem linha em docs/flags.md, com data de decisão. Sem valor = padrão do código.
# Ligar qualquer flag no consumidor corporativo exige o AUTORIZO do Acordo; este arquivo não o dá.

# Flag, desligada por padrão. 1, true ou sim liga o esforço fixo por fase (.claude/phase-effort.json). Piloto da PRI-354.
WATCHER_PHASE_EFFORT=

# Flag, desligada por padrão. 1, true ou sim permite o segmento plan+implement na mesma sessão. Exige pré-build pulado e roteamento OFF.
WATCHER_PLAN_IMPLEMENT_CHAIN=

# Flag, desligada por padrão. 1, true ou sim passa o bloqueio de subagente do plan por permissions.deny. Remoção prevista na F2.5.
WATCHER_PLAN_DENY_SETTINGS=

# Flag, desligada por padrão. 1, true ou sim ativa identidade, store e diagnóstico das recusas de QA (PRI-181). Ligar no consumidor é gate próprio.
WATCHER_QA_DIAGNOSTICO=

# Flag, desligada por padrão. on ativa a verificação de UI em navegador real (docs/ui-verify.md); valor diferente de on e off é erro de uso (UsageError), não conta como off.
PRISMA_UI_VERIFY=

# Flag, desligada por padrão. on liga a rota /api/ui-verify e a tela de verificações de UI no dashboard.
PRISMA_UI_VERIFY_TAB=

# Flag, desligada por padrão. 1 permite servidor de UI customizado (PRISMA_UI_SERVER_CMD ou PRISMA_UI_SERVER_CWD).
PRISMA_UI_CUSTOM_SERVER=

# Comando que sobe o app para a verificação de UI; default `npm start`.
PRISMA_UI_SERVER_CMD=

# Diretório de onde o comando sobe; default dashboard/ da plataforma. Tem de ficar dentro da plataforma ou do checkout.
PRISMA_UI_SERVER_CWD=

# Porta do app na verificação de UI; default 3399.
PRISMA_UI_PORT=

# Globs, separados por vírgula, dos arquivos que contam como frontend; sem valor usa a lista padrão do código.
PRISMA_UI_FRONTEND_GLOBS=

# Espera, em ms, pelo encerramento do servidor de UI; default 8000.
PRISMA_UI_TERM_WAIT_MS=

# Espera, em ms, pela trava da verificação de UI; default 90000.
PRISMA_UI_LOCK_WAIT_MS=

# Flag, desligada por padrão. on mostra "Abrir no Obsidian" no dashboard (docs/obsidian.md); outro valor conta como off.
PRISMA_OBSIDIAN=

# Flag, desligada por padrão. 1 bloqueia as rotas de escrita do dashboard.
PRISMA_DASHBOARD_READONLY=

# Rota `coordination` do dashboard (sai na F2.5). Caminho do arquivo de status; default ~/.maestro-guard/coord-status.json.
COORD_STATUS_PATH=

# Rota `coordination` do dashboard (sai na F2.5). Caminho do script de capacidade; default ~/src/maestro-guard/capacity/capacity.mjs.
COORD_CAPACITY_SCRIPT=
