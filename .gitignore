# Dependências e produtos locais
node_modules/
dist/
build/
coverage/
# O repo usa npm; o pnpm-lock.yaml que aparece solto nas worktrees não entra
pnpm-lock.yaml

# Credenciais e configuração local
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx

# Estado/índices locais conhecidos: esta lista não escolhe onde eles devem residir
memory/runs/
memory/archive/
memory/knowledge-graph.json
.graph/ac-registry.json

# Saída e preferências locais
*.log
**/logs/**/*.jsonl
*.tmp
*.pid
.DS_Store
dashboard/.env
dashboard/local-checkout.json
dashboard/dashboard-prefs.json
# Pasta de configuração que o Obsidian cria ao abrir docs/ como vault
.obsidian/

# Nível de processo da sessão (Acordo v2), lido pelo hook .claude/hooks/processo-level.mjs
.prisma/

# Aprovações locais do navegador de verificação de UI (modelo: .claude/settings.local.json.example)
.claude/settings.local.json
